# Copy to .env for local dev (docker-compose brings up the matching services).
DATABASE_URL=postgres://stade:stade@localhost:5432/stade
REDIS_URL=redis://localhost:6379
BIND_ADDR=0.0.0.0:8080

# Auth [M §7.1.3]
JWT_SECRET=change-me-in-production-min-32-bytes-long
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=2592000

# Ticketing [M §7.1.6] — signing. Default scheme ed25519 (recommended, §2 #3 of blueprint).
# For HMAC-SHA256 instead, set QR_SCHEME=hmac and QR_HMAC_SECRET.
QR_SCHEME=ed25519

# Purchase rules [M §7.1.4]
SEAT_LOCK_TTL_SECS=600        # temporary seat hold window
MAX_TICKETS_PER_ORDER=5       # configurable 1..=5

# Payments — SATIM gateway for CIB/DAHABIA [M §7.4].
# Leave SATIM_USERNAME/PASSWORD empty until SATIM provisions the terminal: the
# server then runs in "mock" mode (tickets issue immediately, for dev/testing).
# When credentials are set, mode flips to "satim" automatically (real redirect
# flow). You can force a mode with PAYMENT_MODE=mock|satim.
# PAYMENT_MODE=
SATIM_BASE_URL=https://cib.satim.dz/payment/rest
SATIM_USERNAME=
SATIM_PASSWORD=
SATIM_TERMINAL=
RETURN_BASE_URL=http://localhost:8080

# One-time admin bootstrap [M §9.1]: set a secret, then
#   curl -X POST $API/api/admin/bootstrap -H "X-Bootstrap-Token: <token>" \
#        -H 'content-type: application/json' -d '{"email":"admin@sogisl.dz"}'
# promotes that (already-registered) user to admin. Leave empty to disable.
BOOTSTRAP_TOKEN=

# Rate limiting / anti-brute-force [M §10.3]
RATE_WINDOW_SECS=60
RATE_MAX=600                 # max requests per IP per window
LOGIN_FAIL_WINDOW_SECS=900
LOGIN_FAIL_MAX=5             # failed logins before temporary lockout

# Email notifications [M §7.6] — leave SMTP_HOST blank until a provider is set
# (flow still works: notifications are logged). Fill these to send real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@stade-aliammar.dz
